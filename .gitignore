# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# -----------------------------
# Comprehensive gitignore
# (Node / Next / Nest / monorepo common patterns)
# -----------------------------

# Node modules
/node_modules/

# Optional PnP
/.pnp/
.pnp.js

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by coverage tools
lib-cov

# Coverage directory
/coverage/
.nyc_output/

# Next.js build output
/.next/
/.next/cache/
/out/

# Build output
/dist/
/build/

# Frontend specific
frontend/out/

# Nest/Backend build output
backend/dist/

# TypeScript
*.tsbuildinfo

# Environment variables
.env
.env.*
.env.local
.env.production

# Vercel, Netlify, Firebase, and hosting
.vercel/
.netlify/
.firebase/

# Storybook
/storybook-static/

# Editor directories and files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace

# Yarn & PnP
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.yarn/
/.yarn/*cache*
/.pnp/
.pnp.js
.pnp.*

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Caches
.cache/
.parcel-cache/
.turbo/
.vite/

# Yarn berry cache
/.yarn/
/.yarn/*cache*

# Temporary files
tmp/
temp/
*.tmp
.temp

# Docker
# ignore docker-compose override files that are often local-only
docker-compose.override.yml

# Certificates and keys
*.pem
*.key
*.crt
*.p12

# Databases
*.sqlite
*.sqlite3
*.db

# Backend-specific logs and diagnostics
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Test output
/coverage/
test-results.xml

# Misc
*.tgz
*.envrc

# Ignore JetBrains project files
.idea/

# Ignore compiled binary addons
build/Release

# Prevent accidentally ignoring lockfiles (uncomment if you want to ignore):
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

